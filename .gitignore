.env
.env.*
**/.env.*
.shioaji.env
.shioaji.credentials.json
.git.invalid-backup-20260808/

# Credentials and private keys (local-only)
*.pem
*.key
*.p12
*.pfx
*.credentials.json
.DS_Store
npm-debug.log*
*.log
*.ndjson
*.tmp

# Package/runtime directories
node_modules/
.venv/
venv/
__pycache__/
cache/
temp/
data/latest.json
data/sessions.json
data/history/*.json
!data/history/.gitkeep
data/automation-logs/
data/intraday/raw/
data/intraday/archive/
data/intraday/research/
data/forward/
data/live-events/
data/raw/
data/ticks/
data/market-data/

# All runtime and market-data files stay local by default.
# Only selected small, immutable research/paper evidence is re-included below.
data/**
!data/research/
!data/research/**/
!data/research/**/FINAL_*MANIFEST.json
!data/research/**/CLOSEOUT_*MANIFEST.json
!data/research/**/EVALUATION*.json
!data/research/**/RUN_STATUS*.json
!data/research/**/*ACCEPTANCE*.json
!data/research/**/*SPEC*.json
!data/research/**/*CONTRACT*.json
!data/research/**/CLOSEOUT_SUMMARY.md
!data/research/**/README*.md

!data/paper/
!data/paper/**/
!data/paper/**/FINAL_*MANIFEST.json
!data/paper/**/CLOSEOUT_*MANIFEST.json
!data/paper/**/*SCHEMA*.json
!data/paper/**/*CONTRACT*.json
!data/paper/**/*AUDIT*.json
!data/paper/**/*SUMMARY*.json
!data/paper/**/*SUMMARY*.md
!data/paper/**/SCOPE_DIFF.json
v2/data/**
v2/reports/*.json
v2/reports/*.txt
!v2/data/.gitkeep
!v2/reports/.gitkeep

# Database/runtime files and purchased/raw archives never belong in Git.
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.tgz
*.tar.gz
*.zip
*.7z
*.rar

# Agent decision logs (show-me-your-work skill)
.audit/
