    "settlementPF",
    "settlementWinRate",
    "settlementFalseBreakoutRate",
    "settlementMAE",
    "settlementMFE",
    "settlementContributionPct"
  ],
  "settlementSafeguards": {
    "sameParametersAcrossViews": true,
    "settlementDependencyHighWhenAllPositiveButNonSettlementTurnsNegativeOrMateriallyWorse": true,
