    "oneToThreeDayDominanceWarning": true,
    "promotionCannotRelyOnlyOnSettlementSubset": true,
    "noSettlementSpecificTuning": true
  },
  "rollPolicy": {
    "crossSessionGapOnDifferentContracts": { "gapState": "ROLL_TRANSITION", "rawGap": null },
    "rollTransitionDoesNotAutomaticallyRejectWholeSession": true,
    "sessionCanRemainResearchEligibleWhenSameTrueContractUsedIntraday": true,
    "outputFlag": "rollSession",
    "requiresStratifiedSensitivity": true,
    "t0MustNotSilentlyUseCrossContractGap": true
